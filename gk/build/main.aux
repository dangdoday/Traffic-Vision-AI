\newacro{AI}[\AC@hyperlink{AI}{AI}]{Artificial Intelligence (Trí tuệ nhân tạo)}
\newacro{ALPR}[\AC@hyperlink{ALPR}{ALPR}]{Automatic License Plate Recognition (Nhận dạng biển số tự động)}
\newacro{CLAHE}[\AC@hyperlink{CLAHE}{CLAHE}]{Contrast Limited Adaptive Histogram Equalization}
\newacro{CNN}[\AC@hyperlink{CNN}{CNN}]{Convolutional Neural Network (Mạng nơ-ron tích chập)}
\newacro{CPU}[\AC@hyperlink{CPU}{CPU}]{Central Processing Unit (Bộ xử lý trung tâm)}
\newacro{CRNN}[\AC@hyperlink{CRNN}{CRNN}]{Convolutional Recurrent Neural Network}
\newacro{CTC}[\AC@hyperlink{CTC}{CTC}]{Connectionist Temporal Classification}
\newacro{CIoU}[\AC@hyperlink{CIoU}{CIoU}]{Complete Intersection over Union (Hàm mất mát định vị)}
\newacro{DFL}[\AC@hyperlink{DFL}{DFL}]{Distribution Focal Loss}
\newacro{EMA}[\AC@hyperlink{EMA}{EMA}]{Exponential Moving Average}
\newacro{FN}[\AC@hyperlink{FN}{FN}]{False Negative (Âm tính giả - Bỏ sót đối tượng)}
\newacro{FP}[\AC@hyperlink{FP}{FP}]{False Positive (Dương tính giả - Bắt nhầm đối tượng)}
\newacro{FPS}[\AC@hyperlink{FPS}{FPS}]{Frames Per Second (Số khung hình trên giây)}
\newacro{GPU}[\AC@hyperlink{GPU}{GPU}]{Graphics Processing Unit (Bộ xử lý đồ họa)}
\newacro{HSV}[\AC@hyperlink{HSV}{HSV}]{Hue, Saturation, Value (Không gian màu)}
\newacro{IoU}[\AC@hyperlink{IoU}{IoU}]{Intersection over Union (Chỉ số Giao trên Hợp)}
\newacro{LSTM}[\AC@hyperlink{LSTM}{LSTM}]{Long Short-Term Memory}
\newacro{mAP}[\AC@hyperlink{mAP}{mAP}]{mean Average Precision (Độ chính xác trung bình)}
\newacro{MOT}[\AC@hyperlink{MOT}{MOT}]{Multi-Object Tracking (Theo dõi đa đối tượng)}
\newacro{OCR}[\AC@hyperlink{OCR}{OCR}]{Optical Character Recognition (Nhận dạng ký tự quang học)}
\newacro{R-CNN}[\AC@hyperlink{R-CNN}{R-CNN}]{Region-based Convolutional Neural Network}
\newacro{RGB}[\AC@hyperlink{RGB}{RGB}]{Red, Green, Blue (Không gian màu đỏ-lục-lam)}
\newacro{ROI}[\AC@hyperlink{ROI}{ROI}]{Region of Interest (Vùng quan tâm)}
\newacro{TP}[\AC@hyperlink{TP}{TP}]{True Positive (Dương tính thật - Dự đoán đúng)}
\newacro{VFL}[\AC@hyperlink{VFL}{VFL}]{Varifocal Loss}
\newacro{VNLP}[\AC@hyperlink{VNLP}{VNLP}]{Vietnamese License Plate (Biển số xe Việt Nam)}
\newacro{YOLO}[\AC@hyperlink{YOLO}{YOLO}]{You Only Look Once (Mô hình phát hiện đối tượng)}
